{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types", "server.ts"],
  
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "vite-ember-ssr-experiment/tests/*": ["./tests/*"],
      "vite-ember-ssr-experiment/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types"
    ]
  }
}
